DATABASE_URL="postgres://user:password@host:5432/atm_deck?sslmode=require"

# Auth.js — generate with: openssl rand -base64 32
AUTH_SECRET=""

# Google OAuth (console.cloud.google.com > APIs & Services > Credentials)
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# LINE Login (developers.line.biz)
AUTH_LINE_ID=""
AUTH_LINE_SECRET=""

# Supabase Realtime — broadcast-only pub/sub for live task/chat updates.
# Not used as the database; Prisma Postgres (DATABASE_URL) remains the DB.
# Both are safe to expose to the browser (project URL + publishable key).
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=""

# Cloudflare R2 (attachments) — dash.cloudflare.com > R2 > Manage API Tokens
R2_BUCKET=""
R2_ENDPOINT=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""

# Web Push (notifications with the app closed) — generate a key pair with:
#   npx web-push generate-vapid-keys
# VAPID_SUBJECT is a contact for the push services: mailto:you@example.com or an https URL.
# Push is simply off until all three are set; in-app and in-tab alerts still work.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT=""
