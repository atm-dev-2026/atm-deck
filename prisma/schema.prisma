// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum BoardVisibility {
  GLOBAL
  DEPARTMENT
  PERSONAL
}

enum BoardRole {
  READ_ONLY
  CAN_EDIT
}

model Board {
  id             String          @id @default(cuid())
  name           String
  visibilityType BoardVisibility @default(PERSONAL)
  ownerId        String
  departmentId   String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  deletedAt      DateTime?

  owner        User          @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  department   Department?   @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  members      BoardMember[]
  columns      Column[]
  labels       Label[]
  activityLogs ActivityLog[]

  @@index([ownerId, deletedAt])
  @@index([visibilityType, departmentId, deletedAt])
}

model BoardMember {
  id        String    @id @default(cuid())
  boardId   String
  userId    String
  role      BoardRole @default(READ_ONLY)
  invitedAt DateTime  @default(now())
  deletedAt DateTime?

  board Board @relation(fields: [boardId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([boardId, userId])
  @@index([userId, deletedAt])
}

enum DepartmentRole {
  MANAGER
  MEMBER
}

// A Department doubles as a user's app-level role: every non-admin user must
// belong to exactly one (enforced in code, see src/lib/current-user.ts).
model Department {
  id             String   @id @default(cuid())
  name           String
  // Members of this department can open /member and manage users/invites.
  canManageUsers Boolean  @default(false)
  createdAt      DateTime @default(now())

  members DepartmentMember[]
  boards  Board[]
  invites AppInvite[]
}

// Single-use, short-lived link that grants its accepter a role (department).
model AppInvite {
  id           String    @id @default(cuid())
  // sha256 of the raw token — the raw token only ever appears in the link.
  tokenHash    String    @unique
  departmentId String
  createdById  String
  createdAt    DateTime  @default(now())
  expiresAt    DateTime
  acceptedById String?
  acceptedAt   DateTime?

  department Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  createdBy  User       @relation("AppInviteCreatedBy", fields: [createdById], references: [id], onDelete: Cascade)
  acceptedBy User?      @relation("AppInviteAcceptedBy", fields: [acceptedById], references: [id], onDelete: SetNull)

  @@index([createdAt])
}

model DepartmentMember {
  id           String         @id @default(cuid())
  departmentId String
  userId       String
  role         DepartmentRole @default(MEMBER)
  joinedAt     DateTime       @default(now())

  department Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([departmentId, userId])
  @@index([userId])
}

model Column {
  id        String    @id @default(cuid())
  name      String
  order     Int
  // Tasks here count as finished: their due dates never show as overdue.
  isDone    Boolean   @default(false)
  boardId   String
  deletedAt DateTime?

  board Board  @relation(fields: [boardId], references: [id], onDelete: Cascade)
  tasks Task[]

  @@index([boardId, deletedAt])
}

enum Priority {
  NONE
  LOW
  MEDIUM
  HIGH
  URGENT
}

model Task {
  id             String    @id @default(cuid())
  number         Int       @unique @default(autoincrement())
  title          String
  description    String?   @db.Text
  order          Int
  priority       Priority  @default(NONE)
  dueDate        DateTime?
  // false: dueDate is a calendar date, stored as UTC midnight of that date.
  // true: dueDate is an exact instant (date + time).
  dueDateHasTime Boolean   @default(false)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?
  columnId       String
  createdById    String?
  assigneeId     String?

  column      Column           @relation(fields: [columnId], references: [id], onDelete: Cascade)
  createdBy   User?            @relation("TaskCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  assignee    User?            @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  labels      Label[]
  checklist   ChecklistItem[]
  attachments TaskAttachment[]

  @@index([columnId, deletedAt])
  @@index([createdById])
  @@index([assigneeId, deletedAt])
}

model TaskAttachment {
  id        String    @id @default(cuid())
  taskId    String
  key       String
  fileName  String
  fileType  String
  fileSize  Int
  createdAt DateTime  @default(now())
  deletedAt DateTime?

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId, deletedAt])
}

model Label {
  id        String    @id @default(cuid())
  name      String
  color     String
  boardId   String
  deletedAt DateTime?

  board Board  @relation(fields: [boardId], references: [id], onDelete: Cascade)
  tasks Task[]

  @@index([boardId, deletedAt])
}

model ChecklistItem {
  id        String    @id @default(cuid())
  text      String
  done      Boolean   @default(false)
  order     Int
  taskId    String
  createdAt DateTime  @default(now())
  deletedAt DateTime?

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId, deletedAt])
}

enum ActivityEntityType {
  BOARD
  COLUMN
  TASK
  LABEL
  BOARD_MEMBER
}

enum ActivityAction {
  CREATED
  UPDATED
  DELETED
  INVITED
  ROLE_CHANGED
  REMOVED
}

model ActivityLog {
  id         String             @id @default(cuid())
  boardId    String
  entityType ActivityEntityType
  entityId   String
  entityName String
  action     ActivityAction
  actorId    String?
  actorName  String
  changes    Json?
  createdAt  DateTime           @default(now())

  board Board @relation(fields: [boardId], references: [id], onDelete: Cascade)
  actor User? @relation("ActivityLogActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([boardId, createdAt])
  @@index([entityType, entityId])
}

enum GlobalRole {
  ADMIN
  USER
}

// Auth.js (next-auth v5) models — required shape for @auth/prisma-adapter
model User {
  id            String     @id @default(cuid())
  name          String?
  email         String?    @unique
  emailVerified DateTime?
  image         String?
  globalRole    GlobalRole @default(USER)

  accounts Account[]
  sessions Session[]

  createdChannels  Channel[]
  channelMembers   ChannelMember[]
  messages         Message[]
  reactions        Reaction[]
  typingIndicators TypingIndicator[]

  ownedBoards           Board[]
  boardMemberships      BoardMember[]
  departmentMemberships DepartmentMember[]
  createdTasks          Task[]             @relation("TaskCreatedBy")
  assignedTasks         Task[]             @relation("TaskAssignee")
  activityLogs          ActivityLog[]      @relation("ActivityLogActor")
  createdInvites        AppInvite[]        @relation("AppInviteCreatedBy")
  acceptedInvites       AppInvite[]        @relation("AppInviteAcceptedBy")
}

model Channel {
  id          String   @id @default(cuid())
  name        String?
  topic       String?
  isDirect    Boolean  @default(false)
  createdById String
  createdAt   DateTime @default(now())

  createdBy User              @relation(fields: [createdById], references: [id])
  members   ChannelMember[]
  messages  Message[]
  typing    TypingIndicator[]
}

model ChannelMember {
  id        String   @id @default(cuid())
  channelId String
  userId    String
  joinedAt  DateTime @default(now())

  channel Channel @relation(fields: [channelId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([channelId, userId])
  @@index([userId])
}

model Message {
  id        String    @id @default(cuid())
  channelId String
  userId    String
  parentId  String?
  body      String    @db.Text
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  editedAt  DateTime?

  channel     Channel      @relation(fields: [channelId], references: [id], onDelete: Cascade)
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  parent      Message?     @relation("ThreadReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies     Message[]    @relation("ThreadReplies")
  reactions   Reaction[]
  attachments Attachment[]

  @@index([channelId, parentId, updatedAt])
  @@index([parentId])
}

model Attachment {
  id        String   @id @default(cuid())
  messageId String
  key       String
  fileName  String
  fileType  String
  fileSize  Int
  createdAt DateTime @default(now())

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([messageId])
}

model Reaction {
  id        String   @id @default(cuid())
  messageId String
  userId    String
  emoji     String
  createdAt DateTime @default(now())

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId, emoji])
}

model TypingIndicator {
  id        String   @id @default(cuid())
  channelId String
  userId    String
  updatedAt DateTime @updatedAt

  channel Channel @relation(fields: [channelId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([channelId, userId])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
}
